- prop 1.12. Usar el primer inciso de lo siguiente para demostrar el resto

\begin{proposition}
Para cualesquiera estados $i, j \in S$. La variable $N_{ij}$ con soporte en $\{0, 1, 2, \dots\} \cup \{\infty\}$ satisface las siguientes propiedades:
\begin{enumerate}
    \item \textbf{La cola de la distribución de $N_{ij}$:} 
    \[  \mathbb{P}(N_{ij} \ge k):=\mathbb{P}(N_{i} \ge k \mid X_0 = i) = f_{ij} f_{jj}^{k-1}, \quad \text{para } k \ge 1. \]
    
    \item \textbf{La función de masa de $N_{ij}$:}
    \[
    \mathbb{P}(N_{ij}=k):=\mathbb{P}(N_{j} = k \mid X_0 = i) =
    \begin{cases}
    1 - f_{ij} & \text{si } k=0 \\
    f_{ij} (1-f_{jj}) f_{jj}^{k-1} & \text{si } k \ge 1
    \end{cases}
    \]
    
    \item \textbf{La esperanza:}
    \[
    \mathbb{E}[N_{ij}]:=\mathbb{E}[N_{j} \mid X_0 = i] = \frac{f_{ij}}{1 - f_{jj}}.
    \]
    (Interpretamos $1/0$ como $\infty$ si $f_{jj}=1$).
    
    \item \textbf{Probabilidad de infinitas visitas:}
    \begin{itemize}
        \item Si $j$ es transitorio ($f_{jj} < 1$): $\mathbb{P}(N_{ij} = \infty) = 0$.
        \item Si $j$ es recurrente ($f_{jj} = 1$): $\mathbb{P}(N_{ij} = \infty) = f_{ij}$.
    \end{itemize}
    
    \item \textbf{Probabilidad de finitas visitas:}
    \begin{itemize}
        \item Si $j$ es transitorio: $\mathbb{P}(N_{ij} < \infty) = 1$.
        \item Si $j$ es recurrente: $\mathbb{P}(N_{ij} < \infty) = 1 - f_{ij}$ (es la probabilidad de nunca visitarlo).
    \end{itemize}
\end{enumerate}
\end{proposition}

